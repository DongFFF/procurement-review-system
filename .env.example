# 环境变量示例
#
# 本文件仅作说明用途。系统实际配置保存在 data/config.json（已 gitignore）。
# 若你希望通过环境变量提供密钥（例如 CI 或容器部署），可参考以下名称。

# ---- 模型接口（可选：等价于在「系统设置」里填写）----
# PROCUREMENT_LLM_BASE_URL=https://api.deepseek.com/v1
# PROCUREMENT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# PROCUREMENT_LLM_MODEL=deepseek-chat

# ---- 服务监听（可选）----
# PROCUREMENT_HOST=127.0.0.1
# PROCUREMENT_PORT=8756

# ---- 知识库自动更新（可选）----
# PROCUREMENT_KB_AUTO_UPDATE=true
# PROCUREMENT_KB_UPDATE_INTERVAL_HOURS=24

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "中直高校采购需求审查系统",
  "version": "0.1.0",
  "identifier": "cn.edu.procurement.review",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "中直高校采购需求审查系统",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    },
    "resources": {
      "../backend": "backend/",
      "../knowledge": "knowledge/"
    }
  }
}
